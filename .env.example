DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=run: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Web Push — daily reminders. Public key only; safe to expose to the browser.
# Generate a pair with: npx web-push generate-vapid-keys --json
# Set the real value on the main app (Cloudflare env var, NOT a secret — it is public).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<paste publicKey from web-push generate-vapid-keys>
