generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  tier          String    @default("free")
  timezone      String    @default("Asia/Taipei")
  dailyGoal     Int       @default(20)
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WordBook {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  level       String?
  sourceType  String   @default("builtin")
  order       Int      @default(0)
  words       Word[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Word {
  id           String    @id @default(cuid())
  wordBookId   String
  headword     String
  phonetic     String?
  partOfSpeech String?
  definitionZh String
  examTags     String[]
  order        Int       @default(0)
  wordBook     WordBook  @relation(fields: [wordBookId], references: [id], onDelete: Cascade)
  examples     Example[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([wordBookId, headword])
}

model Example {
  id            String   @id @default(cuid())
  wordId        String
  sentence      String
  translationZh String
  source        String?
  order         Int      @default(0)
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
}
