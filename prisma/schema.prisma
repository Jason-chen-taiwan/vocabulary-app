generator client {
  provider = "prisma-client-js"
  // DO NOT REMOVE despite the "deprecated preview feature" warning at generate
  // time: these flags are what make Prisma emit the wasm client entry
  // (`@prisma/client/wasm`) that lib/db/client.ts imports to run on Cloudflare
  // Workers. Without them the wasm entry is not generated and the build/tests
  // fail with "Cannot find package '@prisma/client/wasm'".
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  tier          String    @default("free")
  timezone      String    @default("Asia/Taipei")
  dailyGoal     Int       @default(20)
  reminderEnabled  Boolean  @default(false)
  reminderHour     Int      @default(20)
  displayName      String?
  leaderboardOptIn Boolean  @default(false)
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  cards         UserCard[]
  gamification  GamificationState?
  items         UserItem[]
  pushSubscriptions PushSubscription[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WordBook {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  level       String?
  sourceType  String   @default("builtin")
  order       Int      @default(0)
  words       Word[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Word {
  id           String      @id @default(cuid())
  wordBookId   String
  headword     String
  phonetic     String?
  partOfSpeech String?
  definitionZh String
  examTags     String[]
  order        Int         @default(0)
  wordBook     WordBook    @relation(fields: [wordBookId], references: [id], onDelete: Cascade)
  examples     Example[]
  userCards    UserCard[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([wordBookId, headword])
}

model Example {
  id            String   @id @default(cuid())
  wordId        String
  sentence      String
  translationZh String
  source        String?
  order         Int      @default(0)
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model UserCard {
  id            String      @id @default(cuid())
  userId        String
  wordId        String
  due           DateTime
  stability     Float       @default(0)
  difficulty    Float       @default(0)
  elapsedDays   Int         @default(0)
  scheduledDays Int         @default(0)
  reps          Int         @default(0)
  lapses        Int         @default(0)
  state         Int         @default(0)
  learningSteps      Int         @default(0)
  consecutiveCorrect Int         @default(0)
  mastered           Boolean     @default(false)
  lastReview    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  word          Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reviewLogs    ReviewLog[]

  @@unique([userId, wordId])
  @@index([userId, due])
}

model ReviewLog {
  id              String   @id @default(cuid())
  userCardId      String
  rating          Int
  state           Int
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  lastElapsedDays Int
  scheduledDays   Int
  reviewedAt      DateTime @default(now())
  clientRef       String?  @unique // 離線作答 uuid；同步冪等去重（重送安全）
  userCard        UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@index([userCardId])
}

model GamificationState {
  id             String      @id @default(cuid())
  userId         String      @unique
  xp             Int         @default(0)
  level          Int         @default(1)
  coinBalance    Int         @default(0)
  streak         Int         @default(0)
  longestStreak  Int         @default(0)
  lastGoalDate   String?
  reviewsToday   Int         @default(0)
  lastReviewDate String?
  streakFreezes  Int         @default(0)
  weeklyXp       Int      @default(0)
  weekStartDate  String?
  equippedHead   String?
  equippedFace   String?
  equippedNeck   String?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges         UserBadge[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model UserBadge {
  id         String            @id @default(cuid())
  userId     String
  badgeKey   String
  unlockedAt DateTime          @default(now())
  state      GamificationState @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, badgeKey])
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemKey    String
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}
